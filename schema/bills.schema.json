{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "SafeLegalAI AI-in-courts bill",
 "type": "object",
 "additionalProperties": false,
 "properties": {
  "bill_id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9-]{3,90}$"
  },
  "jurisdiction": {
   "type": "string",
   "pattern": "^(US|[A-Z]{2})$"
  },
  "session": {
   "type": "string",
   "maxLength": 40
  },
  "bill_number": {
   "type": "string",
   "maxLength": 30
  },
  "title": {
   "type": "string",
   "maxLength": 240
  },
  "lane": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "enum": [
     "evidence",
     "courts-judiciary",
     "legal-services-upl",
     "attorney-ai-use",
     "police-reports-criminal",
     "legal-aid-a2j",
     "court-records-training"
    ]
   }
  },
  "status": {
   "type": "string",
   "enum": [
    "introduced",
    "in-committee",
    "passed-one-chamber",
    "passed-both",
    "enrolled",
    "signed",
    "in-force",
    "vetoed",
    "veto-sustained",
    "died",
    "withdrawn"
   ]
  },
  "status_date": {
   "type": "string",
   "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
  },
  "last_action": {
   "type": "string",
   "maxLength": 200
  },
  "effective_date": {
   "type": [
    "string",
    "null"
   ]
  },
  "operative_sections": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string",
    "maxLength": 400
   },
   "description": "1–4 statements, each traceable to a section, citing it"
  },
  "summary": {
   "type": "string",
   "minLength": 120,
   "maxLength": 520,
   "description": "40–60 words, descriptive, present tense"
  },
  "sponsors": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "text_url": {
   "type": [
    "string",
    "null"
   ]
  },
  "status_url": {
   "type": [
    "string",
    "null"
   ]
  },
  "legiscan_bill_id": {
   "type": [
    "integer",
    "null"
   ]
  },
  "excerpt": {
   "type": [
    "string",
    "null"
   ],
   "maxLength": 2000,
   "description": "verbatim operative text (public domain)"
  },
  "source_url": {
   "type": "string",
   "format": "uri",
   "description": "primary source (court/regulator/legislature/agency/vendor own site or official API)"
  },
  "archive_url": {
   "type": [
    "string",
    "null"
   ],
   "description": "web.archive.org snapshot of source_url, or null"
  },
  "fetched_at": {
   "type": "string",
   "description": "ISO timestamp of the read"
  },
  "verification": {
   "type": "string",
   "enum": [
    "fetched-and-read",
    "page-read-no-document",
    "link-only",
    "mirror-read"
   ],
   "description": "fetched-and-read = official copy read; mirror-read = the court-authored document was read from a public mirror (e.g. a CC0 database's PDF) and the official URL is pending; page-read-no-document; link-only"
  },
  "lead_source": {
   "type": "array",
   "items": {
    "type": "string"
   },
   "description": "where we learned the row exists (tracker/news/api/crawl); never a source_url"
  },
  "notes": {
   "type": [
    "string",
    "null"
   ],
   "maxLength": 600
  }
 },
 "required": [
  "bill_id",
  "jurisdiction",
  "session",
  "bill_number",
  "title",
  "lane",
  "status",
  "status_date",
  "last_action",
  "operative_sections",
  "summary",
  "source_url",
  "fetched_at",
  "verification",
  "lead_source"
 ]
}